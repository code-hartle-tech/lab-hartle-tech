---
// Theme toggle — 3-state cycle: system → light → dark → system.
// No framework; vanilla DOM. Inline FOUC-prevention script lives in Base.astro <head>.
---

<button id="theme-toggle" type="button" aria-label="Toggle theme">
  <svg id="theme-icon-sys" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
    <line x1="8" y1="21" x2="16" y2="21"></line>
    <line x1="12" y1="17" x2="12" y2="21"></line>
  </svg>
  <svg id="theme-icon-light" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
  </svg>
  <svg id="theme-icon-dark" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
</button>

<script is:inline>
  (function () {
    const ICONS = ['sys', 'light', 'dark'];
    const btn = document.getElementById('theme-toggle');
    const showIcon = (name) => {
      ICONS.forEach((n) => {
        const el = document.getElementById(`theme-icon-${n}`);
        if (el) el.style.display = n === name ? '' : 'none';
      });
    };
    const apply = (mode) => {
      const root = document.documentElement;
      if (mode === 'system') {
        root.removeAttribute('data-theme');
        const sys = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        root.setAttribute('data-theme', sys);
        showIcon('sys');
      } else {
        root.setAttribute('data-theme', mode);
        showIcon(mode);
      }
    };
    const stored = localStorage.getItem('theme') || 'system';
    apply(stored);

    btn.addEventListener('click', () => {
      const current = localStorage.getItem('theme') || 'system';
      const idx = ['system','light','dark'].indexOf(current);
      const next = ['system','light','dark'][(idx + 1) % 3];
      localStorage.setItem('theme', next);

      if (document.startViewTransition) {
        document.startViewTransition(() => apply(next));
      } else {
        apply(next);
      }
    });
  })();
</script>

<style>
#theme-toggle {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 36px; height: 36px;
  background: transparent;
  border: 1px solid var(--surface-3);
  border-radius: var(--radius-1);
  color: var(--text-2);
  cursor: pointer;
  transition: background 150ms ease, color 150ms ease, border-color 150ms ease;
}
#theme-toggle:hover {
  background: var(--surface-2);
  color: var(--text-1);
}
</style>
