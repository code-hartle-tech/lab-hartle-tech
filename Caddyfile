# In-pod Caddy serving the Astro dist.
# Edge TLS + tailnet IP-gate handled by host Caddy on the VPS (vps_dashboard).

:8080 {
  root * /srv
  try_files {path} {path}.html /index.html
  file_server
  encode gzip zstd
  header {
    Cache-Control "public, max-age=300"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
  }
}
